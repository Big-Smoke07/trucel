# Create a Discord application/bot, then paste its token here. Never share it.
DISCORD_TOKEN=

# The ID of the one server where the bot is allowed to work.
GUILD_ID=

# MongoDB Atlas connection string. Keep this secret and set it in Render too.
MONGODB_URI=

# Optional database name. Defaults to upvote_bot.
MONGODB_DB=upvote_bot

# How long voting remains editable after the bot is mentioned on a message.
# Defaults to 15 when omitted.
VOTE_WINDOW_MINUTES=15

# Port used by the keep-alive health endpoint (/health). Defaults to 3000.
PORT=3000
